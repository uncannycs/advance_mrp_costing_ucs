<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_kit_qty_wizard_form" model="ir.ui.view">
        <field name="name">stock.kit.qty.wizard.form</field>
        <field name="model">stock.kit.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Quantity Of Kit">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="kit_qty"/>
                </group>
                <footer>
                    <button string="Update" type="object" name="action_update" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
