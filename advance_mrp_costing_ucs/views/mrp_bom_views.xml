<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_inherit_overhead" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.overhead</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_overhead_details" type="object" class="oe_stat_button" icon="fa-calculator">
                    <field name="overhead_line_count" widget="statinfo" string="Overhead Items"/>
                </button>
            </xpath>

            <!-- Components Tab Footer -->
            <xpath expr="//page[@name='components']//field[@name='bom_line_ids']" position="after">
                <group class="oe_subtotal_footer oe_right">
                    <field name="total_material_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
            </xpath>

            <!-- Notebook Tabs -->
            <xpath expr="//notebook" position="inside">
                <page string="Variable Overhead" name="variable_overhead">
                    <field name="overhead_line_ids">
                        <tree editable="bottom">
                            <field name="product_id" domain="[('type', '=', 'service')]"/>
                            <field name="overhead_type_id"/>
                            <field name="cost_category"/>
                            <field name="quantity"/>
                            <field name="unit_cost" widget="monetary"/>
                            <field name="total_cost" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_overhead_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </page>

                <page string="Costing Summary" name="costing_summary">
                    <group>
                        <group string="Cost Breakdown">
                            <field name="total_material_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_overhead_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_bom_cost" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="unit_bom_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
