<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_unbuild_form_view_inherit_overhead" model="ir.ui.view">
        <field name="name">mrp.unbuild.form.inherit.overhead</field>
        <field name="model">mrp.unbuild</field>
        <field name="inherit_id" ref="mrp.mrp_unbuild_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_unbuild_main_moves" type="object" class="oe_stat_button" icon="fa-book">
                        <field name="unbuild_main_move_count" widget="statinfo" string="Unbuild Move Entries"/>
                    </button>
                    <button name="action_view_unbuild_overhead_moves" type="object" class="oe_stat_button" icon="fa-money">
                        <field name="unbuild_overhead_move_count" widget="statinfo" string="Unbuild Overhead Entries"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Variable Overhead" name="unbuild_overhead">
                        <field name="unbuild_overhead_line_ids">
                            <tree editable="bottom">
                                <field name="product_id" domain="[('type', '=', 'service')]"/>
                                <field name="overhead_type_id"/>
                                <field name="quantity"/>
                                <field name="unit_cost"/>
                                <field name="total_cost" widget="monetary"/>
                                <field name="move_id" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
