<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. BOM Material And Overhead Cost Report -->
    <record id="action_report_bom_overhead" model="ir.actions.report">
        <field name="name">BOM Material &amp; Overhead Cost</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advance_mrp_costing_ucs.report_bom_overhead</field>
        <field name="report_file">advance_mrp_costing_ucs.report_bom_overhead</field>
        <field name="print_report_name">'BOM_Cost_' + object.display_name</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
    </record>

