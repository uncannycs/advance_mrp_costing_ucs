<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_mrp_extra_cost_user" model="res.groups">
        <field name="name">Manufacturing Extra Costs User</field>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_mrp_extra_cost_manager" model="res.groups">
        <field name="name">Manufacturing Extra Costs Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_mrp_extra_cost_user')), (4, ref('mrp.group_mrp_manager'))]"/>
    </record>

    <record id="mrp.group_mrp_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mrp_extra_cost_user'))]"/>
    </record>

    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mrp_extra_cost_manager'))]"/>
    </record>
</odoo>
